{
  "name": "ScrollUniversity",
  "description": "Revolutionary Christian educational platform combining divine revelation with cutting-edge technology",
  "framework": "react-vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "nodeVersion": "20.x",
  "environmentVariables": {
    "required": [
      "VITE_SUPABASE_URL",
      "VITE_SUPABASE_ANON_KEY",
      "VITE_API_URL"
    ],
    "optional": [
      "VITE_STRIPE_PUBLIC_KEY",
      "VITE_ENABLE_PWA",
      "VITE_SENTRY_DSN",
      "VITE_ANALYTICS_ID"
    ]
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "$VITE_API_URL/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "$VITE_API_URL/:path*"
    }
  ]
}
