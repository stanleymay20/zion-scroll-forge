// ============================================================================
// CORE APPLICATION MODELS
// Added to fix missing base models that the entire application depends on
// ============================================================================

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  username          String   @unique
  passwordHash      String   @map("password_hash")
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  role              String   // STUDENT, FACULTY, ADMIN, STAFF
  scrollCalling     String?  @map("scroll_calling")
  spiritualGifts    String[] @map("spiritual_gifts")
  kingdomVision     String?  @map("kingdom_vision")
  scrollAlignment   Float    @default(0) @map("scroll_alignment")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Faculty {
  id          String   @id @default(uuid())
  name        String
  description String
  icon        String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses        Course[]
  degreePrograms DegreeProgram[]

  @@map("faculties")
}

model Course {
  id              String   @id @default(uuid())
  code            String   @unique
  title           String
  description     String
  facultyId       String   @map("faculty_id")
  credits         Int      @default(3)
  level           String   // BEGINNER, INTERMEDIATE, ADVANCED
  prerequisites   String[] @default([])
  corequisites    String[] @default([])
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  faculty         Faculty        @relation(fields: [facultyId], references: [id])
  modules         CourseModule[]

  @@map("courses")
}

model Enrollment {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  courseId        String    @map("course_id")
  status          String    // ENROLLED, COMPLETED, DROPPED
  enrolledAt      DateTime  @default(now()) @map("enrolled_at")
  completedAt     DateTime? @map("completed_at")
  grade           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([userId, courseId])
  @@map("enrollments")
}

// Course Improvement System Models
model CourseImprovementTask {
  id                String   @id
  courseId          String
  title             String
  description       String
  priority          String   // 'critical' | 'high' | 'medium' | 'low'
  impactScore       Float
  affectedStudents  Int
  status            String   // 'pending' | 'in_progress' | 'completed'
  assignedTo        String?
  dueDate           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([courseId])
  @@index([status])
  @@index([priority])
}

model ContentFlag {
  id                  String    @id
  courseId            String
  contentId           String
  contentType         String    // 'lecture' | 'notes' | 'assessment' | 'resource'
  reason              String    // 'age' | 'external_change' | 'feedback' | 'technology_update'
  severity            String    // 'urgent' | 'important' | 'routine'
  flaggedAt           DateTime  @default(now())
  scheduledUpdateDate DateTime?
  resolvedAt          DateTime?

  @@index([courseId])
  @@index([contentId])
  @@index([severity])
}


// ============================================================================
// DEGREE PROGRAM SYSTEM
// Complete academic pathway from Certificate to Doctorate
// ============================================================================

enum DegreeType {
  CERTIFICATE
  DIPLOMA
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
}

enum RequirementCategory {
  CORE
  MAJOR
  MINOR
  ELECTIVE
  SPIRITUAL_FORMATION
  CAPSTONE
  GENERAL_EDUCATION
}

enum DegreeEnrollmentStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  WITHDRAWN
  DISMISSED
}

enum HonorsLevel {
  SUMMA_CUM_LAUDE  // 3.9+
  MAGNA_CUM_LAUDE  // 3.7-3.89
  CUM_LAUDE        // 3.5-3.69
  NONE
}

model DegreeProgram {
  id                      String   @id @default(uuid())
  name                    String
  code                    String   @unique
  degreeType              DegreeType @map("degree_type")
  facultyId               String   @map("faculty_id")
  description             String
  totalCredits            Int      @map("total_credits")
  minimumGpa              Float    @default(2.0) @map("minimum_gpa")
  estimatedDurationMonths Int      @map("estimated_duration_months")
  isActive                Boolean  @default(true) @map("is_active")
  accreditationStatus     String?  @map("accreditation_status")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  faculty                      Faculty                        @relation(fields: [facultyId], references: [id])
  requirements                 DegreeRequirement[]
  enrollments                  DegreeEnrollment[]
  spiritualFormationRequirements SpiritualFormationRequirement[]

  @@index([facultyId], map: "idx_degree_program_faculty")
  @@index([degreeType], map: "idx_degree_program_type")
  @@index([isActive], map: "idx_degree_program_active")
  @@map("degree_programs")
}

model DegreeRequirement {
  id               String              @id @default(uuid())
  degreeProgramId  String              @map("degree_program_id")
  category         RequirementCategory
  name             String
  description      String
  creditHours      Int                 @map("credit_hours")
  requiredCourses  String[]            @map("required_courses")
  electiveOptions  String[]            @map("elective_options")
  minimumGrade     String?             @map("minimum_grade")
  orderIndex       Int                 @default(0) @map("order_index")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  degreeProgram DegreeProgram                @relation(fields: [degreeProgramId], references: [id], onDelete: Cascade)
  progress      DegreeRequirementProgress[]

  @@index([degreeProgramId], map: "idx_degree_requirement_program")
  @@index([category], map: "idx_degree_requirement_category")
  @@map("degree_requirements")
}

model DegreeEnrollment {
  id                     String                  @id @default(uuid())
  userId                 String                  @map("user_id")
  degreeProgramId        String                  @map("degree_program_id")
  status                 DegreeEnrollmentStatus  @default(ACTIVE)
  enrolledAt             DateTime                @default(now()) @map("enrolled_at")
  expectedGraduationDate DateTime?               @map("expected_graduation_date")
  actualGraduationDate   DateTime?               @map("actual_graduation_date")
  cumulativeGpa          Float?                  @map("cumulative_gpa")
  creditsCompleted       Int                     @default(0) @map("credits_completed")
  creditsInProgress      Int                     @default(0) @map("credits_in_progress")
  academicStanding       String?                 @map("academic_standing")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  degreeProgram              DegreeProgram                   @relation(fields: [degreeProgramId], references: [id])
  requirementProgress        DegreeRequirementProgress[]
  spiritualFormationProgress SpiritualFormationProgress[]
  graduationApplications     GraduationApplication[]
  transcripts                OfficialTranscript[]
  diplomas                   Diploma[]

  @@unique([userId, degreeProgramId], map: "unique_user_degree_program")
  @@index([userId], map: "idx_degree_enrollment_user")
  @@index([degreeProgramId], map: "idx_degree_enrollment_program")
  @@index([status], map: "idx_degree_enrollment_status")
  @@map("degree_enrollments")
}

model DegreeRequirementProgress {
  id                   String    @id @default(uuid())
  degreeEnrollmentId   String    @map("degree_enrollment_id")
  degreeRequirementId  String    @map("degree_requirement_id")
  completed            Boolean   @default(false)
  creditsCompleted     Int       @default(0) @map("credits_completed")
  completedCourses     String[]  @map("completed_courses")
  inProgressCourses    String[]  @map("in_progress_courses")
  completionDate       DateTime? @map("completion_date")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  degreeEnrollment  DegreeEnrollment  @relation(fields: [degreeEnrollmentId], references: [id], onDelete: Cascade)
  degreeRequirement DegreeRequirement @relation(fields: [degreeRequirementId], references: [id], onDelete: Cascade)

  @@unique([degreeEnrollmentId, degreeRequirementId], map: "unique_enrollment_requirement")
  @@index([degreeEnrollmentId], map: "idx_requirement_progress_enrollment")
  @@index([degreeRequirementId], map: "idx_requirement_progress_requirement")
  @@map("degree_requirement_progress")
}

model SpiritualFormationRequirement {
  id              String   @id @default(uuid())
  degreeProgramId String   @map("degree_program_id")
  name            String
  description     String
  type            String
  minimumScore    Int?     @map("minimum_score")
  required        Boolean  @default(true)
  orderIndex      Int      @default(0) @map("order_index")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  degreeProgram DegreeProgram                    @relation(fields: [degreeProgramId], references: [id], onDelete: Cascade)
  progress      SpiritualFormationProgress[]

  @@index([degreeProgramId], map: "idx_spiritual_requirement_program")
  @@map("spiritual_formation_requirements")
}

model SpiritualFormationProgress {
  id                     String    @id @default(uuid())
  degreeEnrollmentId     String    @map("degree_enrollment_id")
  spiritualRequirementId String    @map("spiritual_requirement_id")
  completed              Boolean   @default(false)
  score                  Int?
  completionDate         DateTime? @map("completion_date")
  notes                  String?
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  degreeEnrollment       DegreeEnrollment              @relation(fields: [degreeEnrollmentId], references: [id], onDelete: Cascade)
  spiritualRequirement   SpiritualFormationRequirement @relation(fields: [spiritualRequirementId], references: [id], onDelete: Cascade)

  @@unique([degreeEnrollmentId, spiritualRequirementId], map: "unique_enrollment_spiritual_requirement")
  @@index([degreeEnrollmentId], map: "idx_spiritual_progress_enrollment")
  @@map("spiritual_formation_progress")
}

model GraduationApplication {
  id                  String       @id @default(uuid())
  degreeEnrollmentId  String       @map("degree_enrollment_id")
  applicationDate     DateTime     @default(now()) @map("application_date")
  ceremonyDate        DateTime?    @map("ceremony_date")
  status              String       @default("PENDING")
  eligibilityChecked  Boolean      @default(false) @map("eligibility_checked")
  approvedBy          String?      @map("approved_by")
  approvedAt          DateTime?    @map("approved_at")
  diplomaIssued       Boolean      @default(false) @map("diploma_issued")
  diplomaIssuedAt     DateTime?    @map("diploma_issued_at")
  honorsLevel         HonorsLevel  @default(NONE) @map("honors_level")
  notes               String?
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  degreeEnrollment DegreeEnrollment @relation(fields: [degreeEnrollmentId], references: [id], onDelete: Cascade)
  diploma          Diploma?

  @@index([degreeEnrollmentId], map: "idx_graduation_application_enrollment")
  @@index([status], map: "idx_graduation_application_status")
  @@map("graduation_applications")
}

model OfficialTranscript {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  degreeEnrollmentId String?   @map("degree_enrollment_id")
  transcriptType     String    @default("OFFICIAL") @map("transcript_type")
  issuedAt           DateTime  @default(now()) @map("issued_at")
  issuedBy           String    @map("issued_by")
  cumulativeGpa      Float     @map("cumulative_gpa")
  totalCredits       Int       @map("total_credits")
  blockchainHash     String?   @map("blockchain_hash")
  verificationUrl    String?   @map("verification_url")
  pdfUrl             String?   @map("pdf_url")
  createdAt          DateTime  @default(now()) @map("created_at")

  degreeEnrollment DegreeEnrollment? @relation(fields: [degreeEnrollmentId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_transcript_user")
  @@index([degreeEnrollmentId], map: "idx_transcript_enrollment")
  @@map("official_transcripts")
}

model Diploma {
  id                      String       @id @default(uuid())
  graduationApplicationId String       @unique @map("graduation_application_id")
  degreeEnrollmentId      String       @map("degree_enrollment_id")
  userId                  String       @map("user_id")
  degreeTitle             String       @map("degree_title")
  degreeType              DegreeType   @map("degree_type")
  facultyName             String       @map("faculty_name")
  graduationDate          DateTime     @map("graduation_date")
  finalGpa                Float        @map("final_gpa")
  honorsLevel             HonorsLevel  @default(NONE) @map("honors_level")
  blockchainHash          String?      @map("blockchain_hash")
  ipfsHash                String?      @map("ipfs_hash")
  verificationUrl         String?      @map("verification_url")
  pdfUrl                  String?      @map("pdf_url")
  issuedAt                DateTime     @default(now()) @map("issued_at")
  createdAt               DateTime     @default(now()) @map("created_at")

  graduationApplication GraduationApplication @relation(fields: [graduationApplicationId], references: [id])
  degreeEnrollment      DegreeEnrollment      @relation(fields: [degreeEnrollmentId], references: [id])

  @@index([userId], map: "idx_diploma_user")
  @@index([degreeEnrollmentId], map: "idx_diploma_enrollment")
  @@map("diplomas")
}
