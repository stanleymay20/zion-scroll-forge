  id                    String                   @id @default(uuid())
  ruleName              String                   @unique @map("rule_name")
  ruleType              String                   @map("rule_type")
  description           String?
  baseAmount            Int                      @map("base_amount")
  maxAmount             Int?                     @map("max_amount")
  requiresVerification  Boolean                  @default(false) @map("requires_verification")
  cooldownHours         Int?                     @map("cooldown_hours")
  isActive              Boolean                  @default(true) @map("is_active")
  priority              Int                      @default(0)
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  
  earningEvents         ScrollGoldEarningEvent[]
  transactions          ScrollGoldTransaction[]
  
  @@index([ruleType], map: "idx_scrollgold_earning_rule_type")
  @@index([isActive], map: "idx_scrollgold_earning_rule_active")
  @@map("scrollgold_earning_rules")
}

model ScrollGoldWalletBalance {
  id                          String    @id @default(uuid())
  userId                      String    @unique @map("user_id")
  currentBalance              Int       @default(0) @map("current_balance")
  lifetimeEarned              Int       @default(0) @map("lifetime_earned")
  lifetimeSpent               Int       @default(0) @map("lifetime_spent")
  totalModuleCompletions      Int       @default(0) @map("total_module_completions")
  totalStreakDays             Int       @default(0) @map("total_streak_days")
  totalCommunityServiceHours  Decimal   @default(0) @map("total_community_service_hours")
  totalFaithfulPayments       Int       @default(0) @map("total_faithful_payments")
  totalDiscountsAppliedCents  Int       @default(0) @map("total_discounts_applied_cents")
  totalFeaturesUnlocked       Int       @default(0) @map("total_features_unlocked")
  isFrozen                    Boolean   @default(false) @map("is_frozen")
  frozenReason                String?   @map("frozen_reason")
  frozenAt                    DateTime? @map("frozen_at")
  lastTransactionAt           DateTime? @map("last_transaction_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  
  user                        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId], map: "idx_scrollgold_wallet_user")
  @@index([currentBalance], map: "idx_scrollgold_wallet_balance")
  @@map("scrollgold_wallet_balances")
}

model ScrollGoldEarningEvent {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  eventType           String    @map("event_type")
  earningRuleId       String    @map("earning_rule_id")
  amountEarned        Int       @map("amount_earned")
  courseId            String?   @map("course_id")
  moduleId            String?   @map("module_id")
  scorePercentage     Int?      @map("score_percentage")
  streakDays          Int?      @map("streak_days")
  verificationStatus  String    @default("PENDING") @map("verification_status")
  verifiedBy          String?   @map("verified_by")
  verifiedAt          DateTime? @map("verified_at")
  processedAt         DateTime? @map("processed_at")
  transactionId       String?   @map("transaction_id")
  duplicateCheckHash  String?   @map("duplicate_check_hash")
  createdAt           DateTime  @default(now()) @map("created_at")
  
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  earningRule         ScrollGoldEarningRule  @relation(fields: [earningRuleId], references: [id])
  
  @@index([userId], map: "idx_scrollgold_earning_event_user")
  @@index([eventType], map: "idx_scrollgold_earning_event_type")
  @@index([verificationStatus], map: "idx_scrollgold_earning_event_verification")
  @@index([duplicateCheckHash], map: "idx_scrollgold_earning_event_duplicate")
  @@map("scrollgold_earning_events")
}

model ScrollGoldTransaction {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  amount              Int
  transactionType     String    @map("transaction_type")
  reason              String
  category            String?
  balanceAfter        Int       @map("balance_after")
  earningRuleId       String?   @map("earning_rule_id")
  spendingOptionId    String?   @map("spending_option_id")
  subscriptionId      String?   @map("subscription_id")
  paymentId           String?   @map("payment_id")
  billingRelated      Boolean   @default(false) @map("billing_related")
  relatedEntityType   String?   @map("related_entity_type")
  relatedEntityId     String?   @map("related_entity_id")
  metadata            Json      @default("{}")
  verificationStatus  String    @default("PENDING") @map("verification_status")
  fraudCheckPassed    Boolean   @default(true) @map("fraud_check_passed")
  createdAt           DateTime  @default(now()) @map("created_at")
  
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  earningRule         ScrollGoldEarningRule?  @relation(fields: [earningRuleId], references: [id])
  
  @@index([userId], map: "idx_scrollgold_transaction_user")
  @@index([transactionType], map: "idx_scrollgold_transaction_type")
  @@index([billingRelated], map: "idx_scrollgold_transaction_billing")
  @@index([createdAt], map: "idx_scrollgold_transaction_date")
  @@map("scrollgold_transactions")
}


// ============================================================================
// SCROLL PROBLEM IDENTIFICATION SYSTEM
// ============================================================================

model ScrollProblem {
  id                        String                @id @default(uuid())
  title                     String
  description               String
  category                  ProblemCategory
  complexity                ProblemComplexity
  affectedPopulation        Int                   @map("affected_population")
  geographicScope           String                @map("geographic_scope")
  urgency                   Int
  priority                  Int
  currentSolutions          Json                  @map("current_solutions")
  gaps                      Json
  constraints               Json
  stakeholders              Json
  dataAvailable             Json                  @map("data_available")
  successMetrics            Json                  @map("success_metrics")
  kingdomRelevance          Int                   @map("kingdom_relevance")
  scripturalBasis           Json                  @map("scriptural_basis")
  transformationalPotential Int                   @map("transformational_potential")
  requiredSkills            String[]              @map("required_skills")
  estimatedDuration         Int                   @map("estimated_duration")
  isActive                  Boolean               @default(true) @map("is_active")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")
  
  // Relations
  assignments               ProblemAssignment[]
  
  @@index([category])
  @@index([complexity])
  @@index([priority])
  @@index([isActive])
  @@map("scroll_problem")
}

model ProblemAssignment {
  id            String                  @id @default(uuid())
  problemId     String                  @map("problem_id")
  assigneeId    String                  @map("assignee_id")
  assigneeType  AssigneeType            @map("assignee_type")
  assignedAt    DateTime                @default(now()) @map("assigned_at")
  deadline      DateTime
  status        AssignmentStatus        @default(assigned)
  progress      Int                     @default(0)
  notes         String?
  updatedAt     DateTime                @updatedAt @map("updated_at")
  
  // Relations
  problem       ScrollProblem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  milestones    AssignmentMilestone[]
  feedback      AssignmentFeedback[]
  
  @@index([assigneeId, assigneeType])
  @@index([problemId])
  @@index([status])
  @@map("problem_assignment")
}

model AssignmentMilestone {
  id            String              @id @default(uuid())
  assignmentId  String              @map("assignment_id")
  title         String
  description   String?
  dueDate       DateTime            @map("due_date")
  completed     Boolean             @default(false)
  completedAt   DateTime?           @map("completed_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  
  // Relations
  assignment    ProblemAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  @@index([assignmentId])
  @@map("assignment_milestone")
}

model AssignmentFeedback {
  id            String              @id @default(uuid())
  assignmentId  String              @map("assignment_id")
  providerId    String              @map("provider_id")
  providerType  FeedbackProvider    @map("provider_type")
  content       String
  helpful       Boolean             @default(false)
  createdAt     DateTime            @default(now()) @map("created_at")
  
  // Relations
  assignment    ProblemAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  @@index([assignmentId])
  @@map("assignment_feedback")
}

// Enums for ScrollProblem Identification System
enum ProblemCategory {
  climate_solutions
  ai_ethics
  health_access
  biblical_literacy
  economic_justice
  educational_reform
  governance_systems
  spiritual_formation
  social_justice
  technology_access
}

enum ProblemComplexity {
  beginner
  intermediate
  advanced
  expert
}

enum AssigneeType {
  student
  team
}

enum AssignmentStatus {
  assigned
  in_progress
  submitted
  reviewed
  completed
  cancelled
}

enum FeedbackProvider {
  mentor
  peer
  ai
}
