// Core Models to Add to schema.prisma
// These are referenced throughout the application but missing from the schema

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  username            String   @unique
  passwordHash        String   @map("password_hash")
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  role                String   // STUDENT, FACULTY, ADMIN, STAFF
  
  // Spiritual Formation Fields
  scrollCalling       String?  @map("scroll_calling")
  spiritualGifts      String[] @map("spiritual_gifts")
  kingdomVision       String?  @map("kingdom_vision")
  scrollAlignment     Float    @default(0) @map("scroll_alignment")
  
  // Academic & Enrollment Fields
  enrollmentStatus    String   @default("PENDING") @map("enrollment_status")
  academicLevel       String   @default("SCROLL_OPEN") @map("academic_level")
  
  // ScrollGold Economy
  ScrollGoldBalance   Float    @default(0) @map("scroll_gold_balance")
  
  // Contact & Location
  location            String?
  phoneNumber         String?  @map("phone_number")
  
  // Session Management
  lastLoginAt         DateTime? @map("last_login_at")
  
  // Timestamps
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Faculty {
  id          String   @id @default(uuid())
  name        String
  description String
  icon        String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses     Course[]

  @@map("faculties")
}

model Course {
  id              String   @id @default(uuid())
  code            String   @unique
  title           String
  description     String
  facultyId       String   @map("faculty_id")
  credits         Int      @default(3)
  level           String   // BEGINNER, INTERMEDIATE, ADVANCED
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  faculty         Faculty  @relation(fields: [facultyId], references: [id])
  modules         CourseModule[]

  @@map("courses")
}

model Enrollment {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  courseId        String   @map("course_id")
  status          String   // ENROLLED, COMPLETED, DROPPED
  enrolledAt      DateTime @default(now()) @map("enrolled_at")
  completedAt     DateTime? @map("completed_at")
  grade           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, courseId])
  @@map("enrollments")
}
